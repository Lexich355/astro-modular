---
import { siteConfig } from '@/config';
import { generateHomeSEO } from '@/utils/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';

// Define services
const services = [
  {
    name: 'Grafana',
    url: 'https://grafana.anonix.ru',
    description: 'Monitoring and analytics platform',
    icon: '/services/grafana.svg'
  },
  {
    name: 'Wiki',
    url: 'https://wiki.anonix.ru',
    description: 'Knowledge base and documentation',
    icon: '/services/wiki.svg'
  },
  {
    name: 'Rem',
    url: 'https://rem.anonix.ru',
    description: 'Task management system',
    icon: '/services/rem.svg'
  },
  {
    name: 'GitHub',
    url: 'https://github.com',
    description: 'Code repository and collaboration',
    icon: '/services/github.svg'
  }
];

// Generate SEO data for homepage
const seoData = generateHomeSEO(Astro.url.href);
---

<BaseLayout seoData={seoData}>
  <div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl w-full">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl sm:text-5xl font-bold text-primary-900 dark:text-primary-50 mb-4">
          {siteConfig.title}
        </h1>
        <p class="text-lg text-primary-600 dark:text-primary-300">
          {siteConfig.description}
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((service) => (
          <a
            href={service.url}
            target="_blank"
            rel="noopener noreferrer"
            class="service-card group bg-primary-50 dark:bg-primary-900 rounded-xl border-2 border-primary-200 dark:border-primary-700 p-6 transition-all duration-300 hover:border-highlight-500 dark:hover:border-highlight-400 hover:shadow-xl hover:-translate-y-1"
          >
            <div class="flex flex-col items-center text-center space-y-4">
              <!-- Icon -->
              <div class="w-24 h-24 rounded-lg overflow-hidden transition-transform duration-300 group-hover:scale-110">
                <img 
                  src={service.icon} 
                  alt={`${service.name} icon`}
                  class="w-full h-full object-cover"
                />
              </div>
              
              <!-- Service Name -->
              <h2 class="text-xl font-semibold text-primary-900 dark:text-primary-50 group-hover:text-highlight-600 dark:group-hover:text-highlight-400 transition-colors">
                {service.name}
              </h2>
              
              <!-- Description -->
              <p class="text-sm text-primary-600 dark:text-primary-300">
                {service.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .service-card {
    position: relative;
    overflow: hidden;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transition: left 0.5s;
  }

  .service-card:hover::before {
    left: 100%;
  }
</style>
